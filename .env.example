# Environment Variables for Money Scanner
NODE_ENV=development
PORT=3001

# Google Gemini API Key (for AI Market Analyst)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Free public social ingestion (comma-separated search terms)
BLUESKY_SEARCH_QUERIES=bitcoin,ethereum,stock market,gold market

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
# Only public channels in this allow-list are accepted as social sources.
# Add the bot as an administrator in each channel so Telegram sends channel_post updates.
TELEGRAM_SOURCE_CHANNELS=marketalpha,another_public_channel

# Scanner Engine Configuration
SCAN_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=30
DASHBOARD_BASE_URL=https://scanner.relayhub.no

# Ingestion Fallbacks
BINANCE_API_URL=https://api.binance.com/api/v3
