# Environment Variables for Money Scanner
NODE_ENV=development
PORT=3001

# Google Gemini API Key (for AI Market Analyst)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Scanner Engine Configuration
SCAN_INTERVAL_SECONDS=60
ALERT_COOLDOWN_MINUTES=30
DASHBOARD_BASE_URL=https://scanner.relayhub.no

# Ingestion Fallbacks
BINANCE_API_URL=https://api.binance.com/api/v3
